# Optional: without DATABASE_URL the app uses its built-in demo store.
DATABASE_URL=postgresql://user:password@host:5432/tsdb?sslmode=require

# Shared with SENSEMAP_DEVICE_TOKEN on the Raspberry Pi.
DEVICE_TOKEN=replace-with-a-random-token

# Optional: enables Gemini-powered study-space explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
